# generate: docker run --rm aeromax/relaticle php artisan key:generate --show
APP_KEY=
DB_PASSWORD=change-me
REVERB_APP_SECRET=change-me
APP_PORT=8686
# must match how you browse to it, e.g. http://192.168.1.10:8686
APP_URL=http://192.168.1.10:8686
TRUSTED_HOSTS=192.168.1.10
SESSION_SECURE_COOKIE=false
HSTS_MAX_AGE=0

# Email (needed for verification/invite mails). Example: Gmail app password, Mailgun, Resend SMTP, etc.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=crm@yourdomain.com
# Or skip email verification entirely on a private LAN install:
# REQUIRE_EMAIL_VERIFICATION=false
